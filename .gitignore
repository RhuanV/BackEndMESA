.vscode/
.idea/
*.swp
*.swo

# --- Banco de Dados / DBeaver ---
# Ignora arquivos temporários e logs do DBeaver
*.sql.log
*.db
.dbeaver/

# --- Sistema Operacional ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log