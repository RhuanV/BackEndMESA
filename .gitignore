# --- Python ---
# Ignore virtual enviroment files
.venv/
env/
venv/
ENV/

# Bytecode files (generated by Python)
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Files associated with packaging the project
*.egg-info/

# --- Sensitive Settings ---
# Ignore credentials to acess the database and possible secret keys
.env

# --- IDEs and Editors ---
# Ignore specific configurations for VS Code and PyCharm
.vscode/
.idea/
*.swp
*.swo

# --- Database / DBeaver ---
# Ignore temporary files DBeaver logs
*.sql.log
*.db
.dbeaver/

# --- Operating System ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log

# --- Manually Downloaded Data ---
data/*

# --- Local Scripts not intended to be uploaded to GitHub --- 
local_scripts/

# --- Node.js / Frontend ---
frontend/node_modules/
frontend/dist/

README.md

# --- AI assistant artifacts (to be removed from the remote repo manually) ---
.github/copilot-instructions.md
.claude/

