# --- Python ---
# Ignora o ambiente virtual (nunca deve ir para o git)
.venv/
env/
venv/
ENV/

# Arquivos de bytecode (compilados do Python)
**/__pycache__/
*.pyc
*.pyo
*.pyd

# --- Configurações Sensíveis ---
# Ignora as credenciais do banco de dados e chaves secretas
.env

# --- IDEs e Editores ---
