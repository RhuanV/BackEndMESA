# ==============================================================================
# GEOAVIA — MESA-Auto Framework
# Unified Environment Configuration (Monorepo Root)
# ==============================================================================
# IMPORTANT: Never commit this file with real credentials to version control.
# Copy this file to .env and adjust values before starting the project.
#
#   cp .env_example .env
#
# ==============================================================================

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Hostname of the database (use 'db' inside Docker, 'localhost' for external scripts)
DB_HOST=db

# Name of the main application database (used by FastAPI and PostGIS data)
DB_NAME=geoavia_main_db

# Name of the isolated sandbox database. When APP_ENV=sandbox the backend
# connects here instead of DB_NAME, so data created in sandbox never leaks into
# production. It starts empty (no Airflow-loaded geodata) — expected for a
# developer sandbox.
SANDBOX_DB_NAME=geoavia_sandbox_db

# Name of the Airflow metadata database
AIRFLOW_DB=geoavia_airflow_db

# Database username
DB_USER=postgres

# Database password (must be kept secret in production environments)
DB_PASS=123

# Internal database port (default PostgreSQL port inside the container)
DB_PORT=5432

# External database port (exposed to the host machine to avoid local conflicts)
DB_EXT_PORT=5433

# ==============================================================================
# SERVICES PORTS (HOST MAPPING)
# ==============================================================================
# Port exposed to access the FastAPI backend (e.g., http://localhost:8000)
API_PORT=8000

# Port exposed to access the Airflow Web UI (e.g., http://localhost:8080)
AIRFLOW_PORT=8080

# Port exposed to access the React frontend (Vite dev server)
FRONTEND_PORT=5173

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# Secret key used to cryptographically sign the JSON Web Tokens (JWT)
SECRET_KEY=change_for_a_strong_password

# Hashing algorithm used for the JWT signature
ALGORITHM=HS256

# Application environment. "sandbox" gives the 'desenvolvedor' role full write
# access (non-production). Any other value (default "production") makes that
# role read-only and audits its write attempts.
APP_ENV=sandbox

# Comma-separated list of allowed CORS origins for the API. Leave empty to allow
# only the local frontend (http://localhost:${FRONTEND_PORT}). Set your real
# domain(s) in staging/production, e.g. https://app.example.com
CORS_ORIGINS=

# Backend hot-reload. Leave empty (off) — the production-safe default. Set to 1
# only for local backend development to auto-restart uvicorn on code changes.
UVICORN_RELOAD=

# ==============================================================================
# AIRFLOW CREDENTIALS
# ==============================================================================
# Airflow Web UI administrator credentials
AIRFLOW_USER=admin
AIRFLOW_PASS=admin

# ------------------------------------------------------------------------------
# Airflow — TLS verification for government data downloads (RNF03)
# ------------------------------------------------------------------------------
# The ingestion DAGs verify TLS certificates by default (secure_http helper).
# Some government geoservers ship incomplete certificate chains. To fix this
# securely, point GEOAVIA_CA_BUNDLE at a PEM file that includes the missing
# intermediate CA(s); verification stays enabled against that trust store.
GEOAVIA_CA_BUNDLE=

# Last-resort, documented exception ONLY: comma-separated hostnames for which
# TLS verification is skipped (e.g. a source with a genuinely unfixable chain).
# Every skipped request logs a loud security warning. Leave empty to keep
# verification enabled for all hosts (recommended).
GEOAVIA_TLS_INSECURE_HOSTS=

# ==============================================================================
# RASTER PIPELINE (Fase 5 — declividade/uso do solo, MCDA, GeoTIFF)
# ==============================================================================
# Demo município (código IBGE 7 dígitos) seeded for an out-of-the-box working
# analysis. 9999999 is a synthetic demonstration município (see
# backend/seed/PROVENANCE.md). Leave as-is unless you seed a different one.
MESA_DEMO_CODIGO_IBGE=9999999

# Directory where municipal raster COGs are stored (shared raster_data volume).
RASTER_DATA_DIR=/data/raster

# Source URLs for the raster ingestion DAGs. Both are read as HTTP ranges via
# GDAL /vsicurl and clipped per município (no full national download). Override
# to pin a specific ANADEM tile or MapBiomas collection/year.
ANADEM_MDT_URL=https://metadados.snirh.gov.br/files/anadem_v1_tiles/
MAPBIOMAS_LANDUSE_URL=https://storage.googleapis.com/mapbiomas-public/initiatives/brasil/collection-9/coverage/brasil_coverage_2023.tif

# Government TLS: some gov geoservers ship broken certificate chains. Set to
# "YES" ONLY as a documented, last-resort exception so GDAL's /vsicurl skips
# certificate validation for the raster downloads. Leave empty to keep
# verification on (recommended).
GDAL_HTTP_UNSAFESSL=

# ==============================================================================
# BACKEND — UPLOAD LIMITS
# ==============================================================================
SHAPEFILE_MAX_UPLOAD_MB=500

# ==============================================================================
# FRONTEND — VITE ENVIRONMENT VARIABLES
# ==============================================================================
# All variables prefixed with VITE_ are accessible in the browser client.
# WARNING: Never place secrets (API keys, passwords) in VITE_ variables!

# Base URL for API requests (proxied through Vite in development)
VITE_API_BASE_URL=/api

# MapLibre base map style URLs
VITE_MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json
VITE_SATELLITE_STYLE_URL=https://demotiles.maplibre.org/style.json
VITE_OSM_STYLE_URL=https://demotiles.maplibre.org/style.json

# External data source WMS/WMTS URLs (replace with actual endpoints)
VITE_IBGE_WMS_URL=https://geoservicos.ibge.gov.br/geoserver/wms
VITE_MAPBIOMAS_WMS_URL=https://storage.googleapis.com/mapbiomas-public
VITE_CPRM_WMS_URL=https://geosgb.cprm.gov.br/geoserver/wms

# ==============================================================================
# DEMO / BOOTSTRAP USER CREDENTIALS
# ==============================================================================
# Bootstrap accounts created at startup — a single one per environment:
#   - production (APP_ENV != sandbox): the ADMIN_* account (role administrador)
#   - sandbox    (APP_ENV == sandbox): the DEV_* account   (role desenvolvedor)
# Passwords must satisfy the policy (>=8 chars with an uppercase, lowercase,
# digit and special character), since the bootstrap runs the same validation as
# any new user. Change them before any real deployment.
ADMIN_USER=admin
ADMIN_PASS=Admin@1234
ADMIN_ROLE=administrador

DEV_USER=dev
DEV_PASS=Dev@12345
DEV_ROLE=desenvolvedor