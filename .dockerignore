# Keep build contexts small and reproducible.
.git
.github
.gitignore
.venv
venv
env
**/__pycache__/
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# Secrets / local config
.env
.env.*
!.env_example

# Frontend build artifacts and deps (built separately)
frontend/node_modules
frontend/dist
frontend/.vite

# Editor / OS noise
.vscode
.idea
.DS_Store

# Docs and plans not needed at build time
*.md
!README.md
